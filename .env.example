# Async backend: auto | local | trigger
REMOTION_MCP_EXECUTION_MODE=auto
# REMOTION_MCP_STATELESS=true

# S3 / S3-compatible storage
S3_BUCKET=
S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_SIGNED_URL_EXPIRES_SECONDS=3600

# Trigger.dev (required for stateless/trigger mode)
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable

# Optional local overrides
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/google-chrome-stable
# REMOTION_MCP_TASK_DIR=/persistent/remotion-mcp/tasks
# REMOTION_MCP_RUNTIME_DIR=/tmp
