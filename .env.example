# Async backend: auto | local | trigger
REMOTION_MCP_EXECUTION_MODE=auto
# REMOTION_MCP_STATELESS=true

# S3 / S3-compatible storage
S3_BUCKET=
S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Optional public/CDN URL for completed videos
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Signed render/status/upload URLs. Default: 86400 seconds, max: 604800.
S3_RENDER_URL_EXPIRES_SECONDS=86400

# Trigger.dev is required only for stateless/trigger mode.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
