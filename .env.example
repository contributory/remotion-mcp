# Environment mode
# Stateful by default.
# REMOTION_MCP_STATELESS=true

# MCP transport
# Stateful: stdio (default) or http.
# Stateless: always http; this value is ignored if set to stdio.
REMOTION_MCP_TRANSPORT=stdio

# HTTP service
# REMOTION_MCP_HTTP_HOST=127.0.0.1
REMOTION_MCP_HTTP_PORT=3847
# REMOTION_MCP_PUBLIC_BASE_URL=http://127.0.0.1:3847
# REMOTION_MCP_ALLOWED_HOSTS=example.com,localhost

# Stateful local persistence fallback (used only when S3_BUCKET is not set)
# REMOTION_MCP_DATA_DIR=/persistent/remotion-mcp

# S3 / S3-compatible storage
# If S3_BUCKET is set on a stateful MCP, all persistent storage automatically uses S3.
# Stateless mode always requires S3.
S3_BUCKET=
# S3_REGION=us-east-1  # optional; defaults to us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_RENDER_URL_EXPIRES_SECONDS=86400

# Trigger.dev lifecycle tracking (optional)
# TRIGGER_SECRET_KEY=
# TRIGGER_PROJECT_REF=  # only needed by the Trigger.dev CLI/config, not MCP runtime
