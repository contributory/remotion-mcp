{
  "name": "remotion-mcp",
  "version": "1.1.0",
  "description": "MCP server for asynchronous AI-authored Remotion video rendering with S3 and Trigger.dev",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.trigger.json",
    "trigger:dev": "trigger.dev dev",
    "trigger:deploy": "trigger.dev deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@remotion/bundler": "^4.0.526",
    "@remotion/renderer": "^4.0.526",
    "@trigger.dev/sdk": "^4.6.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.526",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@trigger.dev/build": "^4.6.3",
    "@types/node": "^26.6.2",
    "trigger.dev": "^4.6.3",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "bin": {
    "remotion-mcp": "dist/index.js"
  }
}
